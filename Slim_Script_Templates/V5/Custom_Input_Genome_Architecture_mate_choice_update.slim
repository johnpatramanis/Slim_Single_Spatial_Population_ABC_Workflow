//// To check out of bounds individuals
function (object)GetIndividualsOutOfBounds(o<Subpopulation> SUBPOP, numeric WMIN, numeric WMAX, numeric HMIN, numeric HMAX)
{
	
	INDS = SUBPOP.individuals;
	OUTLIERS = INDS[INDS.x < WMIN | INDS.x > WMAX | INDS.y < HMIN | INDS.y > HMAX ];
	
	return OUTLIERS;
	
}

