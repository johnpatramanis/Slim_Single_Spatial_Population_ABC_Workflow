///// Check which Populations have their boundaries removed

REMOVE_BOUNDARIES first() {
	
	print("Boundaries Removed");
	for (RLS in RELEASE_LIST, POP in sim.subpopulations, POP_ID in 1:asInteger(NUMBER_OF_POPS) ){	/// Cycle through populations and list of popualtion to have their boundaries removed
		
		if (RLS){ /// If true for this population, permamently set boundaries to be equal to all space
			
			POP_INFO.getValue(asString(POP_ID)).setValue("WMIN", 0.0);
			POP_INFO.getValue(asString(POP_ID)).setValue("WMAX", WIDTH);
			POP_INFO.getValue(asString(POP_ID)).setValue("HMIN", 0.0);
			POP_INFO.getValue(asString(POP_ID)).setValue("HMAX", HEIGHT);
			
			
		}
	}
}





///// Check which Populations need to be... terminated

KILL_POP first(){
	
for (X in KILL_LIST, POP in sim.subpopulations){ /// Cycle through populations and list of popualtion to be terminated

	if (X){ /// If true for this population
		
		sim.killIndividuals(POP.individuals);
		
		}
	}

}






///// Calcualte Mating interactions
first() {
	
	/// preparation for the reproduction() callback
	for (POP in sim.subpopulations){
		i20.evaluate(POP);
	}

}






/////////////////////////////////////////////
//////////// MATING AND REPRODUCTION ////////

reproduction() { ///// Works for both populations
	
	mate = c();
	mate_choice = c();
	
	for (POP in sim.subpopulations){
		
		///// Search 100 times and pick only unique individuals from that pop
		mates_around = unique(i20.drawByStrength(individual, 100, POP));
		mate_choice_around = i20.strength(individual, mates_around);
		
		///// Add speciecism to strength value (multiply it)
		if(individual.subpopulation == POP){
		mate_choice_around = mate_choice_around * SPECIESISM;
			}
		if(individual.subpopulation != POP){
		mate_choice_around = mate_choice_around * (1 - SPECIESISM);
			}
			
		//// Add them to list of options
		mate = c(mate,mates_around);
		mate_choice =c(mate_choice, mate_choice_around);
		
	}

	
	/////// Final choice
	if (mate.size()>1){
		mate = sample(mate, 1, weights = mate_choice);
		}
	/////// if succesful candidate
	if (mate.size()){ //// If list not empty, mate with chosen individual
		///print(c(individual.subpopulation,mate.subpopulation));
		subpop.addCrossed(individual, mate, count=rpois(1, 3*FECUN));	
		}

}





////////// 1st Gen Hybrids
//// Assigning label to child, fate of child

modifyChild() {

child.tag = 0;
//// if child is offspring of parents from different populations
if(parent1.subpopulation != parent2.subpopulation){

	//// randomly assign the child a population tag
	pool_of_options = c(parent1.subpopulation,parent2.subpopulation);
	random_assignment = sample(pool_of_options, 1);
	child.tag = random_assignment.id;
	}
return T;
}



/////////////////////////////////////////////
//////////// DISPERSAL AND SURVIVAL ////////

early() {
	///////////////////////
	/// For each population move individuals out of bounds, towards their center
	
	
	
	
	
	/// For each population Calculate competition and sruvival
	for (POP in sim.subpopulations, Density_Multiplier in DENSITY_MULT_LIST){
	
		
		
		/// Evaluate pressure from other individuals
		// Measure local density and use it for density regulation
		/// Calculate competition as sum of pressure from all populations multiplied by the age mortality of each individual
		competition = 0;
		inds = POP.individuals;
		ages = inds.age;
		mortality = LifeTable[ages];
		survival = 1 - mortality;		
		
		//// Cycle through competition interactions (but not last one, which is mating interaction)
		for (INTERACTION in community.allInteractionTypes[0:(length(community.allInteractionTypes)-2)] ){
			
			INTERACTION.evaluate(POP);
			competition_inter = INTERACTION.localPopulationDensity(inds); /// competition from a specific interaction (population)
			competition = competition + competition_inter;  /// add to total competition 
		
		}
		
		//// print(c(length(competition),length(inds)));  /// these two should be identical
		inds.fitnessScaling = pmin(0.95,( survival  / (1 + RHO * (1/Density_Multiplier) * competition)));
		
	}

	GEN = sim.cycle;

}





//////////////////////////////
//////////// END OF SIMULATION
late() {
	
	//// Hybrid population assignment
	for (POP in sim.subpopulations, POP_ID in 1:asInteger(NUMBER_OF_POPS) ){ /// for each pop
		
	//// Check for hybrid individuals and change their population assignment
	offspring = POP.subsetIndividuals(maxAge=0);
	
	for (X in seq(1,Npop), NEWPOP in sim.subpopulations){ ///for
	
		hybrids = POP.subsetIndividuals(tag = X, maxAge = 0);
		if (hybrids.size()){
			NEWPOP.takeMigrants(hybrids);
		}
    }
	
	
	/// Disperse offspring
	offspring = POP.subsetIndividuals(maxAge=0);
	
	POP_WMIN = POP_INFO.getValue(asString(POP_ID)).getValue("WMIN");
	POP_WMAX = POP_INFO.getValue(asString(POP_ID)).getValue("WMAX");
	POP_HMIN = POP_INFO.getValue(asString(POP_ID)).getValue("HMIN");
	POP_HMAX = POP_INFO.getValue(asString(POP_ID)).getValue("HMAX");
	
	POP.setSpatialBounds(c(POP_WMIN, POP_HMIN, POP_WMAX, POP_HMAX));
	POP.deviatePositions(offspring, "stopping", 1, "n", SD);
	POP.setSpatialBounds(c(0, 0, WIDTH, HEIGHT));
	
	
	
	
	
	
	
	
	
	
	
	
	}
	
	
	
	if (p1.individualCount == 0) {
		
		catn("Population went extinct! Ending the simulation.");
		GEN=sim.cycle;
		writeFile(OUTDIR + "Slim_Simulation_Failed_To_Finish", asString(GEN) );
		sim.treeSeqOutput(OUTDIR + "Spatial_Simulations_SLim.trees",overwriteDirectory = T);
		sim.outputFull(OUTDIR + "Spatial_Simulations_SLim.output_full");
		sim.simulationFinished();
		
	}
	
	sim.subpopulations.individuals.tag = 0;  //// Reset hybrid label
}



RUNTIME late() {

	catn("End of simulation (run time reached)");
	sim.treeSeqOutput(OUTDIR + "Spatial_Simulations_SLim.trees",overwriteDirectory = T); //// Output Tree Sequences into predefined output file
	sim.outputFull(OUTDIR + "Spatial_Simulations_SLim.output_full"); //// Output Full information on the simulation
	sim.simulationFinished();

}



